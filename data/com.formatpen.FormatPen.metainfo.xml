<component type="desktop-application">
  <id>com.formatpen.FormatPen</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>FormatPen</name>
  <summary>Formatador de pendrive para Linux</summary>
  <description>
    <p>
      FormatPen formata pendrives e outros dispositivos removíveis com interface
      gráfica simples. Lista o disco inteiro (não partições soltas), permite
      escolher FAT32, exFAT, NTFS ou ext4 e reparticiona em uma única partição.
    </p>
    <p>
      A formatação usa UDisks2 e Polkit no sistema — é necessário ter permissão
      de administrador quando solicitado.
    </p>
  </description>
  <launchable type="desktop-id">com.formatpen.FormatPen.desktop</launchable>
